# syntax=docker/dockerfile:1.7

ARG ALPINE_VERSION=3.24

FROM alpine:${ALPINE_VERSION} AS builder

ARG MONERO_VERSION=v0.18.5.1
ARG MONERO_COMMIT=4f92268d7c16741cfb41e5bbe2aa46cc260a9ea5

# Keep the compiler image isolated from the runtime image. Monero's own
# contrib/depends build supplies the pinned static third-party libraries.
# This avoids accidentally linking against Alpine's system Boost/ICU pair.
RUN apk add --no-cache \
        autoconf \
        automake \
        bash \
        build-base \
        bzip2 \
        ca-certificates \
        cmake \
        coreutils \
        curl \
        file \
        git \
        gperf \
        libgcc-static \
        libstdc++-dev \
        libtool \
        linux-headers \
        ninja \
        perl \
        pkgconf \
        python3 \
        tar \
        xz \
        zstd

WORKDIR /src

# Clone the exact release commit and verify that the requested tag did not
# resolve to a different commit.
RUN set -eux; \
    git clone --recursive --depth 1 --branch "${MONERO_VERSION}" \
        https://github.com/monero-project/monero.git /src/monero; \
    test "$(git -C /src/monero rev-parse HEAD)" = "${MONERO_COMMIT}"

WORKDIR /src/monero

# Build the exact dependency set declared by this Monero release. The Alpine
# container is native to the requested Docker platform, so the compiler
# triplet reported by gcc is also the depends host triplet. The default
# depends host tools normally expect a GNU-prefixed cross compiler; override
# them with Alpine's native tool names instead.
RUN --mount=type=cache,target=/src/monero/contrib/depends/sources \
    --mount=type=cache,target=/src/monero/contrib/depends/built \
    set -eux; \
    target="$(gcc -dumpmachine)"; \
    make -C contrib/depends -j"$(nproc)" \
        GITIAN=1 \
        HOST="${target}" \
        default_host_CC=gcc \
        default_host_CXX=g++ \
        default_host_AR=ar \
        default_host_RANLIB=ranlib \
        default_host_STRIP=strip \
        default_host_NM=nm \
        default_host_LIBTOOL=libtool \
        x86_64_linux_CC=gcc \
        x86_64_linux_CXX=g++ \
        aarch64_linux_CC=gcc \
        aarch64_linux_CXX=g++

# Use the toolchain generated by Monero's depends build. In particular, this
# selects its Boost build, which intentionally disables ICU for this release.
RUN set -eux; \
    target="$(gcc -dumpmachine)"; \
    cmake --toolchain "contrib/depends/${target}/share/toolchain.cmake" \
        -S . -B build/release -G Ninja \
        -D CMAKE_BUILD_TYPE=Release \
        -D 'CMAKE_EXE_LINKER_FLAGS=-static -static-libgcc -static-libstdc++' \
        -D BUILD_TESTS=OFF \
        -D BUILD_DOCUMENTATION=OFF \
        -D BUILD_DEBUG_UTILITIES=OFF \
        -D USE_DEVICE_TREZOR=OFF \
        -D USE_READLINE=ON \
        -D STACK_TRACE=OFF \
        -D ARCH=default

RUN set -eux; \
    cmake --build build/release --target simplewallet --parallel "$(nproc)"; \
    test -x build/release/bin/monero-wallet-cli; \
    file build/release/bin/monero-wallet-cli; \
    file build/release/bin/monero-wallet-cli | grep -Eq 'statically linked|static-pie'

FROM alpine:${ALPINE_VERSION}

ENV HOME=/tmp/home

ARG MONERO_VERSION=v0.18.5.1
ARG MONERO_COMMIT=4f92268d7c16741cfb41e5bbe2aa46cc260a9ea5

LABEL org.opencontainers.image.title="mgla Monero wallet" \
      org.opencontainers.image.description="Source-built Monero CLI wallet with an onion-only transport" \
      org.opencontainers.image.source="https://github.com/monero-project/monero" \
      org.opencontainers.image.version="${MONERO_VERSION}" \
      org.opencontainers.image.revision="${MONERO_COMMIT}"

# The wallet binary is static. Runtime packages are limited to the launcher,
# TLS trust store, timezone data, and curl used for onion daemon discovery.
RUN apk add --no-cache \
        bash \
        ca-certificates \
        curl \
        openssl \
        tzdata

RUN apk add --no-cache \
        --repository https://dl-cdn.alpinelinux.org/alpine/edge/main \
        openssl=3.5.8-r0 \
        libssl3=3.5.8-r0 \
        libcrypto3=3.5.8-r0

RUN addgroup -g 1000 -S user \
    && adduser -S -D -H -u 1000 -G user -s /sbin/nologin user \
    && install -d -m 0755 -o root -g root /opt/app /opt/monero \
    && install -d -m 0700 -o 1000 -g 1000 /monero/wallets /tmp/home

COPY --from=builder /src/monero/build/release/bin/monero-wallet-cli /opt/monero/monero-wallet-cli
COPY wallet-launcher.sh /opt/app/monero

RUN chmod 0755 /opt/app/monero /opt/monero/monero-wallet-cli \
    && ln -s /opt/monero/monero-wallet-cli /usr/local/bin/monero-wallet-cli

USER 1000:1000
WORKDIR /opt/app
ENTRYPOINT ["sleep", "infinity"]
